# API Configuration
VITE_API_BASE_URL=http://localhost:8000/api

# Firebase Configuration
# Get these values from your Firebase Console: https://console.firebase.google.com/
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Instructions:
# 1. Go to Firebase Console: https://console.firebase.google.com/
# 2. Create a new project or select existing one
# 3. Go to Project Settings > General
# 4. Scroll down to "Your apps" section
# 5. Click "Add app" and select Web (</>) icon
# 6. Register your app and copy the configuration values
# 7. Create a .env file and paste the values above
# 8. Enable Firestore Database and Storage in Firebase Console

# Stripe keys go in connecta-admin/.env (STRIPE_SECRET, STRIPE_CURRENCY=usd)
# See STRIPE_SETUP.md
